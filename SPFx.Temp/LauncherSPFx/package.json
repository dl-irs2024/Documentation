{
  "name": "spfx-pluggable-launcher",
  "version": "1.0.0",
  "description": "SPFx Pluggable Container Architecture for Modern Web Parts",
  "private": true,
  "scripts": {
    "build": "heft build && npm run build:plugins",
    "build:plugins": "esbuild src/plugins/**/*.ts --bundle --minify --sourcemap --outdir=dist/plugins --splitting --format=esm",
    "dev": "heft dev",
    "dev:plugins": "esbuild src/plugins/**/*.ts --bundle --sourcemap --outdir=dist/plugins --splitting --format=esm --watch",
    "serve": "heft run --debug",
    "test": "heft test",
    "clean": "heft clean"
  },
  "dependencies": {
    "@fluentui/react": "^8.112.8",
    "@microsoft/sp-core-library": "^1.23.0",
    "@microsoft/sp-lodash-subset": "^1.23.0",
    "@microsoft/sp-office-ui-fabric-core": "^1.23.0",
    "@microsoft/sp-webpart-base": "^1.23.0",
    "@azure/msal-browser": "^3.17.0",
    "@microsoft/microsoft-graph-client": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@heft/dev-build-package": "^1.0.0",
    "@microsoft/rush-lib": "^5.118.0",
    "@microsoft/sp-tslint-rules": "^1.23.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
